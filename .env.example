# ============================================================
# Guesty → myDATA Bridge — Environment Variables
# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε τις τιμές
# ΜΗΝ βάλεις ποτέ το .env σε git
# ============================================================

# Server
PORT=3001
NODE_ENV=development
# Never enable this outside an isolated local development environment.
ALLOW_INSECURE_DEV=false

# ────────────────────────────────────────────────────────────
# myDATA ΑΑΔΕ
# sandbox  → https://mydataapidev.aade.gr/SendInvoices
# production → https://mydatapi.aade.gr/myDATA/SendInvoices
# ────────────────────────────────────────────────────────────
MYDATA_ENV=sandbox
MYDATA_TIMEOUT_MS=15000
# A deliberate production circuit breaker. Set to true only after accountant sign-off
# and a successful controlled sandbox validation.
MYDATA_PRODUCTION_ENABLED=false
# Αριθμητικό MARK από την accountant-approved sandbox δοκιμή πριν το go-live.

# Required for the admin API in production. Send as: Authorization: Bearer <token>
ADMIN_API_TOKEN=replace_with_a_long_random_token

# Required before company credentials can be stored. Generate, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key
# Set only during a controlled rotation: old key here, new key above. Run the
# migration, verify connections, then remove this previous key.
DATA_ENCRYPTION_KEY_PREVIOUS=

# ────────────────────────────────────────────────────────────
# Guesty Webhook Secret
# Βρίσκεται στο Guesty Pro → Settings → Webhooks → Secret Key
# ────────────────────────────────────────────────────────────
GUESTY_WEBHOOK_SECRET=your_guesty_webhook_secret_here
GUESTY_CLIENT_ID=your_guesty_open_api_client_id
GUESTY_CLIENT_SECRET=your_guesty_open_api_client_secret

# Αυτόματο κλείσιμο ημέρας (ρητή ενεργοποίηση μετά το sandbox E2E)
DAILY_CLOSE_ENABLED=false
DAILY_CLOSE_TIME=23:55
DAILY_CLOSE_TIMEZONE=Europe/Athens
# Distributed run lease. The worker refreshes it while processing and another
# instance may recover only after it expires.
DAILY_CLOSE_LEASE_SECONDS=300

# ────────────────────────────────────────────────────────────
# Database
# SQLite (default):  μην αλλάξεις τίποτα
# PostgreSQL:        αλλάζεις DB_CLIENT σε "pg" και συμπληρώνεις τα υπόλοιπα
# ────────────────────────────────────────────────────────────
DB_CLIENT=better-sqlite3
DB_PATH=./data/bridge.db

# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=guesty_mydata
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_PRIVATE_NETWORK=true

# Optional font overrides. Docker installs DejaVu automatically.
# PDF_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
