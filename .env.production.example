# Copy this file to .env for Docker Compose. Never commit the resulting .env.

NODE_ENV=production
PORT=3001

# PostgreSQL is mandatory for deployed environments.
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_NAME=guesty_mydata
DB_USER=guesty_mydata
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_PRIVATE_NETWORK=true
# Must remain >=2 because schema migrations hold a dedicated advisory-lock connection.
DB_POOL_MAX=10
POSTGRES_DB=guesty_mydata
POSTGRES_USER=guesty_mydata
POSTGRES_PASSWORD=REPLACE_WITH_THE_SAME_DATABASE_PASSWORD

# Start in the AADE sandbox. Production activation is a separate, controlled step.
MYDATA_ENV=sandbox
MYDATA_TIMEOUT_MS=15000
MYDATA_PRODUCTION_ENABLED=false

# Generate independent high-entropy values. Do not reuse either value elsewhere.
ADMIN_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
# Must decode to exactly 32 bytes: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY
# Temporary only during a key-rotation maintenance window.
DATA_ENCRYPTION_KEY_PREVIOUS=

GUESTY_CLIENT_ID=REPLACE_WITH_GUESTY_OPEN_API_CLIENT_ID
GUESTY_CLIENT_SECRET=REPLACE_WITH_GUESTY_OPEN_API_CLIENT_SECRET
GUESTY_WEBHOOK_SECRET=REPLACE_WITH_GUESTY_WEBHOOK_SIGNING_SECRET

# Keep disabled through sandbox onboarding and the controlled MARK test.
DAILY_CLOSE_ENABLED=false
DAILY_CLOSE_TIME=23:55
DAILY_CLOSE_TIMEZONE=Europe/Athens
DAILY_CLOSE_LEASE_SECONDS=300
